# ============================================================
# STR Platform — Environment Configuration Template
# Copy to .env and fill with real values. NEVER commit .env.
# All values are validated at boot by src/lib/config.ts (Zod).
# ============================================================

# ---------- Application ----------
NODE_ENV=development
APP_NAME="Syrian Tech Renaissance — STR Platform"
APP_VERSION=1.0.0
APP_BASE_URL=http://localhost:3000

# ---------- Database (PostgreSQL — ADR-01) ----------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL="postgresql://str:str_password@localhost:5432/str_platform?schema=public"
# Shadow DB used by Prisma during migration development/reset
DATABASE_SHADOW_URL="postgresql://str:str_password@localhost:5432/str_platform_shadow?schema=public"

# ---------- Auth (ADR-03 — scaffolded in G01, not active) ----------
AUTH_SECRET=               # `openssl rand -base64 32` — required to activate Auth.js later
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=          # Google OIDC — configured in G02
GOOGLE_CLIENT_SECRET=

# ---------- Integration Core (ADR-04 — types only in G01) ----------
INTEGRATIONS_OUTBOX_POLL_INTERVAL_MS=2000
INTEGRATIONS_JOB_TIMEOUT_MS=60000
INTEGRATIONS_WEBHOOK_SECRET=

# ---------- Security ----------
REQUEST_ID_HEADER=x-request-id
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ---------- Logging ----------
LOG_LEVEL=info             # fatal | error | warn | info | debug | trace
LOG_FORMAT=json            # json | pretty (pretty for local dev only)

# ---------- Object Storage (ADR-02 — scaffolded, not connected) ----------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=true

# ---------- i18n ----------
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_LOCALES=ar,en
