# ============================================================
# STR Platform — Staging Environment Template (G10-01)
# ------------------------------------------------------------
# Copy to .env.staging and fill with real staging values.
# NEVER commit .env.staging with real secrets.
#
# This template mirrors .env.example but is tuned for staging:
#   - NODE_ENV=production (not development)
#   - LOG_FORMAT=json (not pretty)
#   - LOG_LEVEL=info (not debug)
#   - Real DATABASE_URL (placeholder here — MASTER provides)
#   - Google OAuth (commented out — configure when ready)
#   - S3 storage (commented out — configure when ready)
#   - Email SMTP (commented out — configure when ready)
# ============================================================

# ---------- Application ----------
NODE_ENV=production
APP_NAME="Syrian Tech Renaissance — STR Platform"
APP_VERSION=1.0.0
APP_BASE_URL=https://staging.example.com

# ---------- Database (PostgreSQL — ADR-01) ----------
# Replace with real staging PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/str_platform?schema=public"
DATABASE_SHADOW_URL="postgresql://USER:PASSWORD@HOST:5433/str_platform_shadow?schema=public"

# ---------- Auth (ADR-03) ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Google OAuth — configure when ready (create Google OAuth app for staging domain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Integration Core (ADR-04) ----------
INTEGRATIONS_OUTBOX_POLL_INTERVAL_MS=2000
INTEGRATIONS_JOB_TIMEOUT_MS=60000
INTEGRATIONS_WEBHOOK_SECRET=

# ---------- Security ----------
REQUEST_ID_HEADER=x-request-id
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ---------- Logging ----------
LOG_LEVEL=info
LOG_FORMAT=json

# ---------- Object Storage (ADR-02 — configure when S3 is wired) ----------
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_USE_PATH_STYLE=true

# ---------- Email Service (configure when SMTP is wired) ----------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@staging.example.com

# ---------- i18n ----------
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_LOCALES=ar,en

# ---------- Worker ----------
# Set STR_WORKER=true in the worker container to enable worker mode.
STR_WORKER=false
