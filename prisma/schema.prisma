// ============================================================
// STR Platform v1.0 — Prisma Schema (G01 baseline)
// ------------------------------------------------------------
// Provider: PostgreSQL (ADR-01). SQLite is NOT supported in production.
// The schema covers the G01 scope only:
//   - Identity foundation (User, AuthIdentity, EmailVerification, AuditEvent)
//   - Integration Core entities (Provider, Capability, Connection, Job, Event)
// Full domain entities (Proposals, Teams, Projects, Opportunities, etc.)
// land in G02–G06 with their own migrations.
//
// Invariants encoded here mirror 03-Data-and-Permissions §"Required database
// invariants". Do not loosen a constraint without an ADR.
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("DATABASE_SHADOW_URL")
  relationMode      = "foreignKeys"
}

// ------------------------------------------------------------
// Identity (module: identity)
// ------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  displayName   String?
  locale        String     @default("ar")
  status        UserStatus @default(UNVERIFIED)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  authIdentities          AuthIdentity[]
  auditEvents             AuditEvent[]
  initiatedJobs           IntegrationJob[]         @relation("JobInitiator")
  consentRecords          ConsentRecord[]
  emailVerifications      EmailVerification[]
  passwordResets          PasswordReset[]
  profile                 MemberProfile?
  roleGrants              RoleGrant[]
  // G03 relations
  proposalsSubmitted      ProjectProposal[]        @relation("ProposalSubmitter")
  proposalsReviewed       ReviewDecision[]
  projectsLed             Project[]                @relation("ProjectLead")
  projectsStewarded       Project[]                @relation("ProjectSteward")
  stewardAssignments      StewardAssignment[]
  teamMemberships         TeamMembership[]
  teamInvitationsSent     TeamInvitation[]         @relation("InvitationInviter")
  teamInvitationsReceived TeamInvitation[]         @relation("InvitationInvitee")
  resourceGrants          ResourceGrant[]          @relation("GrantActor")
  // G04 relations
  opportunitiesCreated    Opportunity[]            @relation("OpportunityCreator")
  opportunityReviews      OpportunityReview[]      @relation("OpportunityReviewer")
  opportunityApplications OpportunityApplication[] @relation("OpportunityApplicant")
  notifications           Notification[]
  // G05 relations — Project Execution and Deliverables
  tasksAssigned           Task[]                   @relation("TaskAssignee")
  tasksAssignedBy         Task[]                   @relation("TaskAssigner")
  deliverablesSubmitted   Deliverable[]            @relation("DeliverableSubmitter")
  deliverableReviews      DeliverableReview[]      @relation("DeliverableReviewer")
  contributionsMade       ContributionReference[]  @relation("ContributionContributor")
  contributionsAccepted   ContributionReference[]  @relation("ContributionAccepter")
  filesUploaded           FileEvidence[]           @relation("FileUploader")

  // G06-A relations — Organizations, Partnerships, Rights Declarations
  organizationsVerified        Organization[]                @relation("OrgVerifier")
  orgRepresentativeRoles       OrganizationRepresentative[]  @relation("OrgRepresentative")
  repVerifierFor               OrganizationRepresentative[]  @relation("RepVerifier")
  partnershipRequestsInitiated PartnershipRequest[]         @relation("PartnershipRequester")
  partnershipDecisionsMade     PartnershipDecision[]         @relation("PartnershipDecider")
  agreementsUploaded           AgreementReference[]          @relation("AgreementUploader")
  rightsDeclared               ContributionRightsDeclaration[] @relation("RightsDeclarer")
  rightsReviewed               ContributionRightsDeclaration[] @relation("RightsReviewer")

  // G06-B relations — Threads, Moderation, Impact
  threadsCreated              ProjectThread[]           @relation("ThreadCreator")
  threadMessagesAuthored      ThreadMessage[]           @relation("ThreadMessageAuthor")
  moderationComplaintsFiled   ModerationComplaint[]      @relation("ModerationComplainant")
  moderationComplaintsTargeted ModerationComplaint[]     @relation("ModerationTarget")
  moderationDecisionsMade     ModerationDecision[]       @relation("ModerationDecider")
  messagesRemoved             ThreadMessage[]              @relation("MessageRemover")
  impactRecordsRecorded       ImpactRecord[]            @relation("ImpactRecorder")


  @@index([email])
}

enum UserStatus {
  UNVERIFIED // registered but email not verified
  ACTIVE // verified, in good standing
  SUSPENDED // governance suspension
  DELETED // soft-deleted; data retained per policy
}

model AuthIdentity {
  // STR-06 + 03-Data §invariant 1: (provider, providerSub) globally unique.
  // Email is normalized but NEVER trusted as the sole external identity key.
  id           String    @id @default(cuid())
  userId       String
  provider     String // "password" | "google" | future OIDC providers
  providerSub  String // immutable provider id (e.g. Google `sub`)
  emailAtLink  String // email at the time of linking (audit only)
  passwordHash String? // only set when provider = "password"
  linkedAt     DateTime  @default(now())
  unlinkedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSub])
  @@index([userId])
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // store hash, never the raw token
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// ------------------------------------------------------------
// Audit (module: governance) — minimal G01 subset
// ------------------------------------------------------------

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String? // null for system events
  action     String // e.g. "user.register", "integration.job.submit"
  targetType String // e.g. "User", "IntegrationJob"
  targetId   String?
  outcome    String // "success" | "failure" | "denied"
  reason     String?
  reqId      String? // correlation id
  meta       Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([reqId])
}

// ------------------------------------------------------------
// Integration Core (module: integrations) — ADR-04
// ------------------------------------------------------------

model IntegrationProvider {
  // G01 stores the static registry; G07 adds the governance approval flow.
  id             String   @id // stable slug+version, e.g. "str.mock.v1"
  slug           String
  version        String
  displayName    String
  description    String
  owner          String
  baseOrigin     String
  trustStatus    String   @default("registered") // "registered" | "approved" | "suspended" | "revoked"
  authMode       Json
  webhookSigning Json?
  // G07: approval workflow
  approvedById   String?  // admin who approved
  approvedAt    DateTime?
  // G07: mock vs real labeling (CRITICAL: mock must NOT be presented as real)
  isMock        Boolean  @default(false) // true for mock/dev providers
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  capabilities IntegrationCapability[]
  connections  IntegrationConnection[]

  @@unique([slug, version])
  @@index([trustStatus])
  @@index([isMock])
}

model IntegrationCapability {
  id              String   @id @default(cuid())
  providerId      String
  code            String // namespaced, e.g. "application.test"
  summary         String
  executionMode   String // "sync" | "async"
  riskClass       String // "low" | "medium" | "high" | "critical"
  requiredScopes  String[] // PostgreSQL native array
  inputSchemaRef  String
  outputSchemaRef String
  idempotent      Boolean  @default(false)
  cancelable      Boolean  @default(false)
  timeoutMs       Int
  createdAt       DateTime @default(now())

  provider IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, code])
  @@index([code])
}

model IntegrationConnection {
  // 03-Data §invariant 8: credentials stored via CredentialReference, never
  // plaintext in exposed queries. This model holds only the reference id.
  id                    String    @id @default(cuid())
  providerId            String
  subjectKind           String // "user" | "project" | "organization"
  subjectId             String
  credentialReferenceId String
  status                String    @default("pending") // "pending" | "active" | "suspended" | "revoked"
  scopes                String[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  revokedAt             DateTime?
  revokedReason         String?   @db.Text
  // G07: webhook signing secret (HMAC key) — per-connection, hashed
  webhookSecretHash     String?   // Argon2id hash of the signing secret
  // G07: suspend lifecycle
  suspendedAt          DateTime?
  suspendedReason      String?   @db.Text

  provider       IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  // G07: subjectId is polymorphic (subjectKind: "user" | "project" | "organization")
  // No FK constraint — the subjectKind field determines which table to reference.
  // This prevents FK violations when subjectId is a projectId (not a userId).
  jobs           IntegrationJob[]
  consentRecords ConsentRecord[]

  @@unique([providerId, subjectKind, subjectId])
  @@index([subjectKind, subjectId])
  @@index([status])
}

model ConsentRecord {
  id           String   @id @default(cuid())
  connectionId String
  grantedBy    String // actor id
  scopes       String[]
  evidence     String // "explicit_consent" | "governance_approval"
  at           DateTime @default(now())

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [grantedBy], references: [id], onDelete: Cascade)

  @@index([connectionId])
}

model IntegrationJob {
  // 03-Data §invariant 9: job belongs to a connection AND authorized subject.
  // Project suspension / grant revocation blocks new jobs (enforced in service).
  id              String    @id @default(cuid())
  connectionId    String
  capability      String
  initiatorId     String?
  subjectKind     String
  subjectId       String
  status          String    @default("queued") // "queued" | "running" | "succeeded" | "failed" | "cancelled" | "timed_out"
  idempotencyKey  String
  payload         Json
  result          Json?
  failureCategory String?
  failureMessage  String?
  retryable       Boolean?
  createdAt       DateTime  @default(now())
  queuedAt        DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  // G07: worker claim (atomic job claiming for concurrent workers)
  claimedBy      String?    // worker instance ID
  claimedAt      DateTime?
  // G07: timeout tracking
  timeoutMs      Int        @default(30000) // default 30s; overridden by capability.timeoutMs
  timeoutAt      DateTime?  // computed: startedAt + timeoutMs
  // G07: cancellation
  cancelReason   String?   @db.Text
  cancelledById  String?

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  initiator  User?                 @relation("JobInitiator", fields: [initiatorId], references: [id], onDelete: SetNull)

  @@unique([connectionId, idempotencyKey])
  @@index([status, queuedAt])
  @@index([subjectKind, subjectId])
  @@index([claimedBy, claimedAt])
  @@index([status, claimedAt])
}

model IntegrationEvent {
  // 03-Data §invariant 10: dedupe by (providerId, providerEventId).
  id              String   @id @default(cuid())
  providerId      String
  providerEventId String
  connectionId    String?
  jobId           String?
  type            String
  payload         Json
  signatureValid  Boolean
  receivedAt      DateTime @default(now())

  @@unique([providerId, providerEventId])
  @@index([jobId])
}

model CredentialReference {
  // The actual secret is stored in a key manager (ADR-04). This row holds only
  // the metadata needed to locate and rotate it.
  id              String    @id @default(cuid())
  encryptionKeyId String
  cipherPreview   String // non-sensitive fingerprint for audit logs
  rotatedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([encryptionKeyId])
}

// ------------------------------------------------------------
// Outbox (ADR-02) — durable job dispatch
// ------------------------------------------------------------

model OutboxEvent {
  id           String    @id @default(cuid())
  aggregate    String // e.g. "integration.job"
  aggregateId  String
  type         String // e.g. "integration.job.submitted"
  payload      Json
  dispatchedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([dispatchedAt])
  @@index([aggregate, aggregateId])
}

// ============================================================
// G02 — Identity, Profiles and Roles
// ============================================================

// ------------------------------------------------------------
// Roles (module: governance) — RBAC foundation
// ------------------------------------------------------------

model RoleGrant {
  // Global roles only in G02 (member, admin). Project-scoped roles
  // (project_lead, steward, team_member) arrive in G03 with a scope field.
  id        String    @id @default(cuid())
  userId    String
  role      String // "member" | "admin"
  scope     String    @default("global") // future: "project:xxx"
  grantedBy String?
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scope])
  @@index([userId])
}

// ------------------------------------------------------------
// Professional Profiles (module: profiles)
// ------------------------------------------------------------

model MemberProfile {
  id              String              @id @default(cuid())
  userId          String              @unique
  displayName     String
  headline        String? // short professional title
  bio             String?             @db.Text
  avatarUrl       String?
  contactEmail    String? // separate from auth email; visible per settings
  location        String?
  websiteUrl      String?
  availability    ProfileAvailability @default(CLOSED)
  completenessPct Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills     MemberSkill[]
  portfolio  PortfolioItem[]
  visibility ProfileVisibility?

  @@index([availability])
}

enum ProfileAvailability {
  OPEN // actively seeking opportunities
  LIMITED // open to select opportunities
  CLOSED // not currently available
}

model Skill {
  id             String @id @default(cuid())
  name           String @unique
  // Normalized lowercase for dedup; display uses original casing.
  normalizedName String @unique

  memberSkills MemberSkill[]

  @@index([normalizedName])
}

model MemberSkill {
  id        String     @id @default(cuid())
  profileId String
  skillId   String
  level     SkillLevel @default(INTERMEDIATE)

  profile MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model PortfolioItem {
  id          String    @id @default(cuid())
  profileId   String
  title       String
  description String?   @db.Text
  url         String?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profile MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model ProfileVisibility {
  // Controls what is visible on the public profile view. The auth email
  // is NEVER shown publicly; only contactEmail (if set + showContact=true).
  id               String  @id @default(cuid())
  profileId        String  @unique
  showContact      Boolean @default(false)
  showLocation     Boolean @default(false)
  showSkills       Boolean @default(true)
  showPortfolio    Boolean @default(true)
  showAvailability Boolean @default(true)

  profile MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ============================================================
// G03 — Project Proposals and Team Governance
// ============================================================
// Implements STR-GOV-TEAM-01: no operational team without an approved
// project charter, named team lead, and institutional steward.
// All constraints enforced in DB + service layer, NOT just UI.
// ============================================================

// ------------------------------------------------------------
// Project Proposals (module: proposals)
// ------------------------------------------------------------

model ProjectProposal {
  id                String         @id @default(cuid())
  submitterId       String
  status            ProposalStatus @default(DRAFT)
  title             String
  // The latest charter revision is the "current" one. Revisions are immutable
  // once submitted; revising creates a new CharterRevision row.
  currentRevisionId String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  withdrawnAt       DateTime?

  submitter       User              @relation("ProposalSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  currentRevision CharterRevision?  @relation("ProposalCurrentRevision", fields: [currentRevisionId], references: [id])
  revisions       CharterRevision[]
  reviewDecisions ReviewDecision[]
  project         Project?

  @@index([submitterId])
  @@index([status])
}

enum ProposalStatus {
  DRAFT // submitter is still editing
  SUBMITTED // sent for review
  NEEDS_REVISION // reviewer requested changes; submitter can revise
  APPROVED // approved → atomic team creation triggered
  REJECTED // rejected with reason
  WITHDRAWN // submitter withdrew
}

model CharterRevision {
  // Immutable once created. Each revision captures a full snapshot of the
  // charter at the time of submission/revision.
  id                      String   @id @default(cuid())
  proposalId              String
  version                 Int // 1, 2, 3... increments per proposal
  // Charter sections (per G03 §1)
  problemStatement        String   @db.Text
  outcomes                String   @db.Text
  scope                   String   @db.Text
  exclusions              String?  @db.Text
  beneficiaries           String?  @db.Text
  preliminaryArchitecture String?  @db.Text
  requiredSkills          String[] // array of skill names
  resources               String?  @db.Text
  risks                   String?  @db.Text
  rights                  String?  @db.Text
  acceptanceCriteria      String   @db.Text
  // Metadata
  createdBy               String // userId who created this revision
  createdAt               DateTime @default(now())
  // Immutable after submission; draft revisions can be edited.
  isSubmitted             Boolean  @default(false)

  proposal        ProjectProposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  currentFor      ProjectProposal? @relation("ProposalCurrentRevision")
  reviewDecisions ReviewDecision[]

  @@unique([proposalId, version])
  @@index([proposalId])
}

model ReviewDecision {
  id           String       @id @default(cuid())
  proposalId   String
  reviewerId   String
  revisionId   String
  action       ReviewAction // APPROVE, REJECT, REQUEST_REVISION
  reason       String       @db.Text
  // Conflict-of-interest guard: reviewer cannot be the submitter.
  // Enforced in service layer + tested.
  isSelfReview Boolean      @default(false) // always false; tracked for audit
  decidedAt    DateTime     @default(now())

  proposal ProjectProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  reviewer User            @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  revision CharterRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([reviewerId])
}

enum ReviewAction {
  APPROVE
  REJECT
  REQUEST_REVISION
}

// ------------------------------------------------------------
// Projects & Teams (module: projects, module: teams)
// ------------------------------------------------------------

model Project {
  // Created atomically when a proposal is approved. Exactly one project per
  // approved proposal (unique constraint). The atomic approval transaction
  // creates Project + Team + StewardAssignment + Lead membership together.
  id                          String        @id @default(cuid())
  proposalId                  String        @unique // one project per approved proposal
  leadId                      String
  stewardId                   String // institutional steward (required, non-null)
  title                       String
  status                      ProjectStatus @default(ACTIVE)
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  suspendedAt                 DateTime?
  cancelledAt                 DateTime?
  // G05 — Two-phase completion approval (lead first, steward second).
  // Lead approves (sets leadApprovedCompletionAt) → steward approves
  // (sets stewardApprovedCompletionAt + completedAt + status=COMPLETED atomically).
  // Anti-self-approval: lead !== steward is enforced by STR-GOV-TEAM-01 + service layer.
  leadApprovedCompletionAt    DateTime?
  stewardApprovedCompletionAt DateTime?
  completedAt                 DateTime?

  proposal       ProjectProposal         @relation(fields: [proposalId], references: [id])
  lead           User                    @relation("ProjectLead", fields: [leadId], references: [id])
  steward        User                    @relation("ProjectSteward", fields: [stewardId], references: [id])
  team           Team?
  memberships    TeamMembership[]
  resourceGrants ResourceGrant[]
  opportunities  Opportunity[]
  // G05 relations
  milestones     Milestone[]
  tasks          Task[]
  contributions  ContributionReference[]
  fileEvidence   FileEvidence[]

  // G06-A relations
  partnershipRequests PartnershipRequest[]

  // G06-B relations
  threads             ProjectThread[]
  moderationComplaints ModerationComplaint[]
  impactRecords       ImpactRecord[]


  @@index([leadId])
  @@index([stewardId])
  @@index([status])
}

enum ProjectStatus {
  ACTIVE // approved and operational
  SUSPENDED // resources suspended; no new jobs
  CANCELLED // permanently cancelled
  COMPLETED // finished (future, G05)
}

model Team {
  // The operational team for a project. Exactly one team per project (unique).
  // There is NO endpoint to create a team directly — teams are created ONLY
  // by the atomic approveProjectProposal() transaction.
  id        String   @id @default(cuid())
  projectId String   @unique // one team per project
  name      String
  createdAt DateTime @default(now())

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberships TeamMembership[]
  invitations TeamInvitation[]

  @@index([projectId])
}

model TeamMembership {
  id       String    @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole  @default(MEMBER)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  @@unique([teamId, userId])
  @@index([userId])
}

enum TeamRole {
  LEAD // team lead (set at approval; can invite members)
  STEWARD // institutional steward (oversight, not daily work)
  MEMBER // regular team member
}

model TeamInvitation {
  id          String           @id @default(cuid())
  teamId      String
  inviteeId   String
  inviterId   String
  role        TeamRole         @default(MEMBER)
  status      InvitationStatus @default(PENDING)
  message     String?          @db.Text
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitee User @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviter User @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([teamId, inviteeId, status]) // prevent duplicate pending invites
  @@index([inviteeId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model StewardAssignment {
  // Records the institutional steward for a project. The steward provides
  // oversight and escalation — they are NOT the team lead. The steward is
  // required at approval time (atomic transaction fails without one).
  id           String    @id @default(cuid())
  projectId    String    @unique // one active steward per project
  stewardId    String
  assignedBy   String?
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  steward User @relation(fields: [stewardId], references: [id], onDelete: Cascade)

  @@index([stewardId])
}

model ResourceGrant {
  // Tracks resource grants to a project/team. Suspension revokes these.
  id           String    @id @default(cuid())
  projectId    String
  grantType    String // e.g., "integration:mock", "storage:bucket"
  scope        String    @db.Text // detailed scope
  grantedBy    String?
  grantedAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokeReason String?   @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation("GrantActor", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([grantType])
}

// ============================================================
// G05 — Project Execution and Deliverables
// ============================================================

// ------------------------------------------------------------
// Milestones (module: projects)
// ------------------------------------------------------------

model Milestone {
  // Major project checkpoints. Created by lead or steward. Optional dueDate.
  // Lifecycle: PLANNED → IN_PROGRESS → COMPLETED | CANCELLED.
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String          @db.Text
  status      MilestoneStatus @default(PLANNED)
  dueDate     DateTime? // optional per MASTER decision §5
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

enum MilestoneStatus {
  PLANNED // created, not yet started
  IN_PROGRESS // actively being worked on
  COMPLETED // all required tasks/deliverables accepted
  CANCELLED // cancelled by lead or steward
}

// ------------------------------------------------------------
// Tasks (module: projects)
// ------------------------------------------------------------

model Task {
  // Work item assigned to a team member by the lead or steward.
  // Lifecycle: ASSIGNED → IN_PROGRESS → SUBMITTED → (CHANGES_REQUESTED → SUBMITTED)*
  //            → ACCEPTED | REJECTED | WITHDRAWN
  id           String     @id @default(cuid())
  projectId    String
  milestoneId  String? // optional link to a milestone
  assigneeId   String // team member who executes
  assignedById String // lead or steward who assigns
  title        String
  description  String     @db.Text
  status       TaskStatus @default(ASSIGNED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  acceptedAt   DateTime? // assignee acknowledged the assignment (ASSIGNED → IN_PROGRESS)
  submittedAt  DateTime? // latest submission timestamp
  withdrawnAt  DateTime? // assignee withdrew

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone    Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee     User          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedBy   User          @relation("TaskAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  deliverables Deliverable[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([assignedById])
  @@index([status])
  @@index([milestoneId])
}

enum TaskStatus {
  ASSIGNED // lead/steward assigned; assignee hasn't acknowledged yet
  IN_PROGRESS // assignee accepted and is working
  SUBMITTED // assignee submitted a deliverable for review
  CHANGES_REQUESTED // reviewer requested changes; assignee can resubmit
  ACCEPTED // reviewer accepted the latest deliverable version
  REJECTED // reviewer rejected the deliverable (terminal)
  WITHDRAWN // assignee withdrew (terminal — separate from CANCELLED which is admin-side)
}

// ------------------------------------------------------------
// Deliverables + Versions + Reviews (module: projects)
// ------------------------------------------------------------

model Deliverable {
  // One per task. Holds a sequence of immutable versions submitted by the assignee.
  // The current version counter advances on each new submission.
  // status reflects the latest review action.
  id             String            @id @default(cuid())
  taskId         String
  submitterId    String // must be the task's assignee
  currentVersion Int               @default(0) // 0 = no versions yet; 1+ = submitted versions count
  status         DeliverableStatus @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  submittedAt    DateTime? // first submission timestamp
  acceptedAt     DateTime? // final acceptance timestamp (one per deliverable)

  task         Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submitter    User                   @relation("DeliverableSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  versions     DeliverableVersion[]
  reviews      DeliverableReview[]
  contribution ContributionReference?

  @@index([taskId])
  @@index([submitterId])
  @@index([status])
}

model DeliverableVersion {
  // IMMUTABLE after creation (per MASTER architectural constraint §4).
  // Each resubmission creates a new row with incremented versionNumber.
  // The artifactPath references FileEvidence (which itself enforces scan status).
  // Reviewers approve a specific version; resubmission creates a new version
  // for review — the previously-approved version is NOT overwritten.
  id             String   @id @default(cuid())
  deliverableId  String
  versionNumber  Int // monotonic: 1, 2, 3, ...
  // For textual deliverables (G05 fallback per MASTER §1): content stored inline.
  textContent    String?  @db.Text
  // For file-backed deliverables: opaque reference to FileEvidence (scan-gated).
  fileEvidenceId String?
  notes          String   @db.Text // submitter's notes for this version
  submittedAt    DateTime @default(now())

  deliverable  Deliverable   @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  fileEvidence FileEvidence? @relation(fields: [fileEvidenceId], references: [id], onDelete: SetNull)

  @@unique([deliverableId, versionNumber]) // version number unique per deliverable
  @@index([deliverableId])
}

model DeliverableReview {
  // Audit trail of review actions. One row per review action.
  // Prevents conflicting reviews via optimistic lock on Deliverable.status
  // + unique partial index: only one review per (deliverableId, versionNumber)
  // — enforced at service layer since PG partial unique indexes on (status=accepted)
  // are awkward; instead service layer uses transaction + status check.
  id              String                  @id @default(cuid())
  deliverableId   String
  reviewerId      String // lead or steward (not the submitter)
  versionNumber   Int // which version was reviewed
  action          DeliverableReviewAction
  reason          String                  @db.Text
  attributionText String?                 @db.Text // finalized attribution text (only on ACCEPT)
  decidedAt       DateTime                @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  reviewer    User        @relation("DeliverableReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  // One review action per (deliverable, version) — prevents conflicting reviews
  // of the same version by different reviewers or by the same reviewer twice.
  @@unique([deliverableId, versionNumber])
  @@index([deliverableId])
  @@index([reviewerId])
  @@index([versionNumber])
}

enum DeliverableStatus {
  DRAFT // created but no version submitted yet
  SUBMITTED // current version submitted, awaiting review
  IN_REVIEW // reviewer started reviewing (informational; SUBMITTED is the trigger)
  CHANGES_REQUESTED // reviewer asked for changes; assignee can resubmit
  ACCEPTED // reviewer accepted — contribution reference recorded
  REJECTED // reviewer rejected (terminal)
  WITHDRAWN // submitter withdrew the deliverable (terminal)
}

enum DeliverableReviewAction {
  REQUEST_CHANGES // ask for revisions
  ACCEPT // accept this version → create ContributionReference
  REJECT // reject this version (terminal for the deliverable)
}

// ------------------------------------------------------------
// Contribution References (module: projects) — attribution hook
// ------------------------------------------------------------

model ContributionReference {
  // Created when a deliverable version is accepted. Attribution only —
  // does NOT transfer or assign IP rights (per MASTER decision §4).
  // Auto-generated from contribution facts; reviewer can finalize text.
  // One per accepted deliverable (unique on deliverableId).
  id              String   @id @default(cuid())
  deliverableId   String   @unique // one accepted version per deliverable
  projectId       String
  contributorId   String // the assignee who submitted the accepted version
  acceptedById    String // the reviewer who accepted (lead or steward)
  acceptedVersion Int // version number that was accepted
  attributionText String   @db.Text // human-readable attribution
  acceptedAt      DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rightsDeclaration ContributionRightsDeclaration?
  contributor User        @relation("ContributionContributor", fields: [contributorId], references: [id], onDelete: Cascade)
  acceptedBy  User        @relation("ContributionAccepter", fields: [acceptedById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([contributorId])
  @@index([acceptedById])
}

// ------------------------------------------------------------
// File Evidence (module: projects) — minimal G05, full scanner in G07
// ------------------------------------------------------------

model FileEvidence {
  // Safe-storage reference. scanStatus enforces fail-closed policy:
  // PENDING files CANNOT be read, downloaded, or used as accepted evidence.
  // No manual/UI promotion to CLEAN — only the scanner (G07) can transition.
  // Authorized read URLs are issued ONLY when scanStatus === CLEAN.
  id           String         @id @default(cuid())
  projectId    String
  uploadedById String
  storageKey   String // opaque key in safe object storage
  fileName     String
  mimeType     String
  sizeBytes    Int
  scanStatus   FileScanStatus @default(PENDING)
  scannedAt    DateTime?
  scanError    String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy          User                 @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  deliverableVersions DeliverableVersion[]

  @@index([projectId])
  @@index([scanStatus])
  @@index([uploadedById])
}

enum FileScanStatus {
  PENDING // uploaded, not yet scanned — CANNOT be read or accepted
  CLEAN // scanned, no threats found — can be referenced and read
  INFECTED // scanner found a threat — must NOT be read or accepted
  SCAN_FAILED // scanner error — treated like PENDING (fail-closed)
}

// ============================================================
// G06-A — Organizations, Partnerships, and Contribution Rights
// ============================================================
// Architectural constraints (per MASTER G06 Authorization):
//   1. NO automated legally-binding contract generation.
//   2. NO automated IP transfer. Rights declarations are claims requiring
//      context + evidence, NOT legal facts the system proves.
//   3. A representative CANNOT verify their own delegated authority —
//      requires independent authorized party (admin).
//   4. Agreement files with INFECTED scan status CANNOT be used as evidence;
//      if discovered after approval, operational reliance is suspended
//      pending institutional review (historical decision preserved).
//   5. Service-layer authorization only (UI is not authoritative).
// ============================================================

// ------------------------------------------------------------
// Organizations + Representatives (module: organizations)
// ------------------------------------------------------------

model Organization {
  id           String             @id @default(cuid())
  legalName    String             // verified legal name (only admin can set/verify)
  displayName  String
  email        String             @unique // primary contact
  website      String?
  status       OrganizationStatus @default(PENDING_VERIFICATION)
  verifiedAt   DateTime?
  verifiedById String?            // admin who verified (must NOT be self — independent)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  suspendedAt  DateTime?
  suspendedReason String?         @db.Text
  revokedAt    DateTime?
  revokedReason String?           @db.Text

  // Relations
  representatives      OrganizationRepresentative[]
  partnershipRequests  PartnershipRequest[] // where this org is the partner
  verifiedBy           User? @relation("OrgVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
}

enum OrganizationStatus {
  PENDING_VERIFICATION // registered, awaiting admin verification
  ACTIVE // verified, operational
  SUSPENDED // suspended (operational pause; reversible)
  REVOKED // permanently revoked (terminal)
}

model OrganizationRepresentative {
  // A user authorized to act on behalf of an organization.
  // delegatedAuthorityScope documents WHAT they can do (evidence-backed).
  // CANNOT self-verify — requires independent admin verification.
  id                      String   @id @default(cuid())
  organizationId          String
  userId                  String
  role                    String   // "signatory" | "liaison" | "observer"
  delegatedAuthorityScope String   @db.Text // evidence-backed scope of authority
  verifiedAt              DateTime?
  verifiedById            String?  // admin who verified (must NOT be self)
  revokedAt               DateTime?
  revokeReason            String?  @db.Text
  createdAt               DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("OrgRepresentative", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy   User?        @relation("RepVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId]) // one representative role per (org, user)
  @@index([organizationId])
  @@index([userId])
  @@index([verifiedAt])
}

// ------------------------------------------------------------
// Partnership Requests + Decisions + Agreement References (module: partnerships)
// ------------------------------------------------------------

model PartnershipRequest {
  // Partnership request initiated by a verified rep of an organization.
  // Decisions are atomic (optimistic lock on status).
  // Agreement references are evidence, NOT legally-binding contracts.
  id              String              @id @default(cuid())
  requesterId     String              // user who initiated (must be verified rep of org)
  organizationId  String              // the partner org
  projectId       String?             // optional project scope (existing project)
  proposalText    String              @db.Text // human-readable partnership proposal
  status          PartnershipStatus   @default(SUBMITTED)
  submittedAt     DateTime           @default(now())
  decidedAt       DateTime?
  // If the agreement evidence is later found to be INFECTED, operational
  // reliance is suspended pending review (historical decision preserved).
  agreementSuspendedAt DateTime?
  agreementSuspendReason String?     @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User                 @relation("PartnershipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decisions    PartnershipDecision[]
  agreement    AgreementReference?

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([requesterId])
}

enum PartnershipStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

model PartnershipDecision {
  // Audit trail of partnership decisions. One row per decision.
  // Anti-self-decision: decider cannot be the requester (conflict of interest).
  id                   String                  @id @default(cuid())
  partnershipRequestId String
  deciderId            String                  // partnership_manager or admin (NOT the requester)
  action               PartnershipDecisionAction
  reason               String                  @db.Text
  decidedAt            DateTime                @default(now())

  partnershipRequest PartnershipRequest @relation(fields: [partnershipRequestId], references: [id], onDelete: Cascade)
  decider            User                @relation("PartnershipDecider", fields: [deciderId], references: [id], onDelete: Cascade)

  @@index([partnershipRequestId])
  @@index([deciderId])
}

enum PartnershipDecisionAction {
  APPROVE
  REJECT
  REQUEST_REVISION
}

model AgreementReference {
  // Evidence of a signed agreement — NOT a system-generated legal contract.
  // scanStatus enforces fail-closed: INFECTED files cannot be used as evidence.
  // No real download URL is issued unless scanStatus === CLEAN (G07 will add real scanner).
  id                   String   @id @default(cuid())
  partnershipRequestId String   @unique // one agreement per partnership
  storageKey           String   // opaque key in safe object storage
  fileName             String
  mimeType             String
  sizeBytes            Int
  scanStatus           FileScanStatus @default(PENDING)
  scannedAt            DateTime?
  scanError            String?  @db.Text
  uploadedById         String
  uploadedAt           DateTime @default(now())

  partnershipRequest PartnershipRequest @relation(fields: [partnershipRequestId], references: [id], onDelete: Cascade)
  uploadedBy         User                 @relation("AgreementUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([scanStatus])
}

// ------------------------------------------------------------
// Contribution Rights Declarations (module: partnerships)
// Extends G05's ContributionReference with optional rights declarations.
// ------------------------------------------------------------

model ContributionRightsDeclaration {
  // Records a rights declaration attached to an accepted contribution.
  // Does NOT auto-transfer IP — the declaration is evidence of what the
  // contributor declared, NOT what was transferred.
  // Optional: a contribution can exist without a rights declaration.
  // declarationType semantics:
  //   - LICENSE_GRANTED: license to use (NOT ownership transfer)
  //   - ATTRIBUTION_ONLY: explicit no-transfer, attribution only
  //   - WORK_FOR_HIRE: contributor declares work-for-hire status (claim, NOT proof)
  //   - OTHER: see declarationText for details
  id              String                 @id @default(cuid())
  contributionId  String                 @unique // one declaration per contribution
  declaredById    String                 // the contributor (or their verified rep)
  declarationType RightsDeclarationType
  declarationText String                 @db.Text // human-readable declaration
  evidenceStorageKey String?             // optional scanned signed evidence (e.g., signed PDF)
  evidenceScanStatus FileScanStatus?     // null if no evidence file
  evidenceScannedAt  DateTime?
  declaredAt      DateTime               @default(now())
  reviewedAt      DateTime?              // optional admin review
  reviewedById    String?

  contribution ContributionReference @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  declaredBy  User                   @relation("RightsDeclarer", fields: [declaredById], references: [id], onDelete: Cascade)
  reviewedBy  User?                  @relation("RightsReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([contributionId])
  @@index([declaredById])
  @@index([declarationType])
}

enum RightsDeclarationType {
  LICENSE_GRANTED
  ATTRIBUTION_ONLY
  WORK_FOR_HIRE
  OTHER
}

// ============================================================
// G06-B — Threads, Moderation, Admin, and Impact
// ============================================================
// Architectural constraints (per MASTER G06 Authorization):
//   1. NO deletion of original records or evidence on moderation decisions
//      (CONTENT_REMOVED removes visibility, not the row; original preserved).
//   2. USER_SUSPENDED requires admin approval (NOT moderator alone); atomic
//      with audit event. No self-suspension.
//   3. Threads are project-scoped (no global forum); close action is terminal.
//   4. Impact records are append-only; corrections via new linked record.
//   5. Service-layer authorization only (UI is not authoritative).
// ============================================================

// ------------------------------------------------------------
// Project-Scoped Threads (module: communications)
// ------------------------------------------------------------

model ProjectThread {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  topic       String?  // e.g., "charter-revision", "milestone-blocker", "rights-clarification"
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  closedAt    DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator   User    @relation("ThreadCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  messages  ThreadMessage[]
  moderationComplaints ModerationComplaint[]

  @@index([projectId])
  @@index([updatedAt])
}

model ThreadMessage {
  id          String   @id @default(cuid())
  threadId    String
  authorId    String
  body        String   @db.Text
  createdAt   DateTime @default(now())
  editedAt    DateTime?
  // G06 moderation correction: removedAt + removedById for CONTENT_REMOVED enforcement.
  // When set, the message is hidden from regular users in read paths.
  // The original body is preserved for authorized auditors (admin/moderator).
  removedAt   DateTime?
  removedById String?

  thread  ProjectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author  User           @relation("ThreadMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  removedBy User?        @relation("MessageRemover", fields: [removedById], references: [id], onDelete: SetNull)
  complaintTargetMessage ModerationComplaint[] @relation("ComplaintTargetMessage")

  @@index([threadId])
  @@index([authorId])
  @@index([removedAt])
}

// ------------------------------------------------------------
// Moderation (module: moderation)
// ------------------------------------------------------------

model ModerationComplaint {
  id               String   @id @default(cuid())
  complainantId    String
  projectId        String?  // optional project scope
  threadId         String?  // optional thread scope
  targetUserId     String?  // optional user scope
  targetMessageId  String?  // optional specific message (for CONTENT_REMOVED targeting)
  reason           String   @db.Text
  evidenceText     String?   @db.Text  // quoted content (preserves original even if message later removed)
  status           ModerationStatus @default(SUBMITTED)
  submittedAt      DateTime @default(now())
  decidedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  complainant     User             @relation("ModerationComplainant", fields: [complainantId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  thread          ProjectThread?   @relation(fields: [threadId], references: [id], onDelete: SetNull)
  targetUser      User?            @relation("ModerationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetMessage   ThreadMessage?   @relation("ComplaintTargetMessage", fields: [targetMessageId], references: [id], onDelete: SetNull)
  decisions       ModerationDecision[]

  @@index([projectId])
  @@index([status])
  @@index([targetUserId])
  @@index([targetMessageId])
}

enum ModerationStatus {
  SUBMITTED
  UNDER_REVIEW
  RESOLVED_WARNING
  RESOLVED_REMOVED
  RESOLVED_DISMISSED
  RESOLVED_SUSPENDED // terminal status for USER_SUSPENDED decisions (not ESCALATED)
  ESCALATED
}

model ModerationDecision {
  id          String   @id @default(cuid())
  complaintId String
  deciderId   String
  action      ModerationAction
  reason      String   @db.Text
  decidedAt   DateTime @default(now())

  complaint ModerationComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  decider   User                 @relation("ModerationDecider", fields: [deciderId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([deciderId])
}

enum ModerationAction {
  WARNING
  CONTENT_REMOVED
  USER_SUSPENDED
  DISMISS
  ESCALATE
}

// ------------------------------------------------------------
// Impact Records (module: impact) — append-only
// ------------------------------------------------------------

model ImpactRecord {
  id            String   @id @default(cuid())
  projectId     String
  metricName    String
  metricValue   Int
  evidenceUrl   String?  // optional URL to evidence (dashboard, screenshot)
  recordedById  String
  recordedAt    DateTime @default(now())
  supersedesId  String?  // if this record corrects a previous one

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("ImpactRecorder", fields: [recordedById], references: [id], onDelete: Cascade)
  supersedes ImpactRecord? @relation("ImpactSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy ImpactRecord[] @relation("ImpactSupersession")

  @@index([projectId])
  @@index([metricName])
}

// ============================================================
// G04 — Talent and Opportunity Workflows
// ============================================================

// ------------------------------------------------------------
// Opportunities (module: opportunities)
// ------------------------------------------------------------

model Opportunity {
  id                  String            @id @default(cuid())
  title               String
  description         String            @db.Text
  type                OpportunityType   @default(PROJECT)
  status              OpportunityStatus @default(DRAFT)
  // Who created this opportunity (the "owner").
  createdById         String
  // Optional link to an approved G03 project.
  projectId           String?
  // Required skills/qualifications (free text, not linked to Skill table
  // because opportunities may need skills not yet in the platform).
  requirements        String?           @db.Text
  // Location/remote.
  location            String?
  isRemote            Boolean           @default(true)
  // Compensation type.
  compensationType    String? // "volunteer" | "paid" | "stipend" | "equity"
  compensationNote    String?           @db.Text
  // Deadline for applications.
  applicationDeadline DateTime?
  // Lifecycle timestamps.
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  submittedAt         DateTime?
  publishedAt         DateTime?
  closedAt            DateTime?
  cancelledAt         DateTime?

  // Relations
  createdBy    User                     @relation("OpportunityCreator", fields: [createdById], references: [id], onDelete: Cascade)
  project      Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  applications OpportunityApplication[]
  reviews      OpportunityReview[]

  @@index([status])
  @@index([createdById])
  @@index([type])
}

enum OpportunityType {
  PROJECT // project-based collaboration
  TASK // specific task/bugfix
  MENTORSHIP // mentorship slot
  INTERNSHIP // internship position
  CONSULTING // consulting engagement
  OTHER
}

enum OpportunityStatus {
  DRAFT // creator is still editing
  SUBMITTED // sent for editorial review
  NEEDS_REVISION // reviewer requested changes
  PUBLISHED // published and visible to members
  CLOSED // applications closed (manually or deadline)
  CANCELLED // creator cancelled
}

// ------------------------------------------------------------
// Opportunity Reviews (editorial review decisions)
// ------------------------------------------------------------

model OpportunityReview {
  id            String                  @id @default(cuid())
  opportunityId String
  reviewerId    String
  action        OpportunityReviewAction
  reason        String                  @db.Text
  decidedAt     DateTime                @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  reviewer    User        @relation("OpportunityReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([reviewerId])
}

enum OpportunityReviewAction {
  APPROVE // publish the opportunity
  REJECT // reject with reason
  REQUEST_REVISION // ask creator to revise
}

// ------------------------------------------------------------
// Opportunity Applications (module: opportunities)
// ------------------------------------------------------------

model OpportunityApplication {
  id                 String            @id @default(cuid())
  opportunityId      String
  applicantId        String
  status             ApplicationStatus @default(SUBMITTED)
  // Applicant's cover note / pitch.
  coverNote          String?           @db.Text
  // Reviewer's qualification notes (private — not visible to applicant).
  qualificationNotes String?           @db.Text
  // Decision reason (visible to applicant on decision).
  decisionReason     String?           @db.Text
  // Idempotency key to prevent duplicate applications.
  idempotencyKey     String
  // Timestamps.
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  decidedAt          DateTime?
  withdrawnAt        DateTime?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicant   User        @relation("OpportunityApplicant", fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, applicantId]) // one application per user per opportunity
  @@index([opportunityId])
  @@index([applicantId])
  @@index([status])
}

enum ApplicationStatus {
  SUBMITTED // submitted, awaiting review
  UNDER_REVIEW // reviewer is evaluating
  ACCEPTED // accepted
  REJECTED // rejected with reason
  WITHDRAWN // applicant withdrew
}

// ------------------------------------------------------------
// Notifications (module: communications) — G04-02 §D
// ------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String // recipient
  type      String // "opportunity.published" | "opportunity.revision_requested" | "application.accepted" | "application.rejected" | "application.withdrawn" | "application.submitted"
  title     String
  body      String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
